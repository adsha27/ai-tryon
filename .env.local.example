# 1. Vercel Blob — run: vercel env pull
#    OR: vercel.com → project → Storage → Blob → Create store → copy token
BLOB_READ_WRITE_TOKEN=

# 2. Modal endpoints — after: modal deploy modal_inference/app.py
#    Modal prints the URLs. Also add BLOB_READ_WRITE_TOKEN as a Modal secret:
#    modal secret create vercel-blob BLOB_READ_WRITE_TOKEN=<your-token>
MODAL_TRYON_START_URL=
MODAL_TRYON_STATUS_URL=
MODAL_BGREMOVE_URL=
